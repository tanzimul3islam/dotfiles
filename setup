#!/bin/bash
# Fedora Atomic Sway Setup - Clean & Unified

set -euo pipefail

readonly DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly XDG_CONFIG_HOME="${HOME}/.config"
readonly XDG_DATA_HOME="${HOME}/.local/share"
readonly LOG_FILE="${HOME}/.sway-setup.log"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

# Packages
readonly PACKAGES=(
  "sway"
  "waybar"
  "alacritty"
  "nautilus"
  "k9s"
  "rofi"
  "tmux"
  "zsh"
  "zsh-autosuggestions"
  "zsh-syntax-highlighting"
  "neovim"
  "ripgrep"
  "fd-find"
  "fzf"
  "git"
  "wl-clipboard"
  "xclip"
  "jq"
  "grim"
  "slurp"
  "swayidle"
  "swaylock"
  "mako"
  "network-manager-applet"
  "sddm"
  "qt6-qtsvg"
  "qt6-qtvirtualkeyboard"
  "qt6-qtmultimedia"
)

# ============================================================================
# Utility Functions
# ============================================================================

log() { echo -e "${GREEN}[✓]${NC} $*" | tee -a "${LOG_FILE}"; }
info() { echo -e "${BLUE}[•]${NC} $*" | tee -a "${LOG_FILE}"; }
warn() { echo -e "${YELLOW}[!]${NC} $*" | tee -a "${LOG_FILE}"; }
error() {
  echo -e "${RED}[✗]${NC} $*" | tee -a "${LOG_FILE}"
  exit 1
}

print_header() {
  echo "" | tee -a "${LOG_FILE}"
  echo -e "${BLUE}════════════════════════════════════════${NC}" | tee -a "${LOG_FILE}"
  echo -e "${BLUE}  $1${NC}" | tee -a "${LOG_FILE}"
  echo -e "${BLUE}════════════════════════════════════════${NC}" | tee -a "${LOG_FILE}"
  echo "" | tee -a "${LOG_FILE}"
}

# ============================================================================
# System Detection
# ============================================================================

is_fedora_atomic() {
  [[ -f /run/ostree-booted ]] && return 0
  [[ -f /etc/os-release ]] || return 1
  # shellcheck disable=SC1091
  . /etc/os-release
  [[ "${VARIANT_ID:-}" =~ ^(silverblue|kinoite|sericea|sway-atomic)$ ]]
}

check_system() {
  print_header "System Check"

  if is_fedora_atomic; then
    log "Fedora Atomic detected"
    return 0
  else
    warn "Not Fedora Atomic (may be in container/Flatpak)"
    warn "Skipping package installation - please install manually on host:"
    warn "  sudo rpm-ostree install --assumeyes ${PACKAGES[*]}"
    return 0
  fi
}

# ============================================================================
# Package Installation
# ============================================================================

install_packages() {
  print_header "Installing Packages"

  if ! is_fedora_atomic; then
    warn "Skipping package installation (not on Fedora Atomic)"
    warn "Run on host Fedora Atomic system to install packages:"
    warn "  sudo rpm-ostree install --assumeyes ${PACKAGES[*]}"
    return 0
  fi

  info "Using rpm-ostree for Fedora Atomic..."

  local requested_packages=()
  if command -v jq >/dev/null 2>&1; then
    while IFS= read -r package_name; do
      [[ -n "${package_name}" ]] && requested_packages+=("${package_name}")
    done < <(
      rpm-ostree status --json 2>/dev/null | jq -r '
        .deployments[0] as $deployment
        | [
            ($deployment.requestedPackages // []),
            ($deployment.packages // [])
          ]
        | flatten[]
        | select(type == "string")
      ' 2>/dev/null | sort -u
    )
  fi

  local packages_to_install=()
  for package_name in "${PACKAGES[@]}"; do
    if printf '%s
' "${requested_packages[@]}" | grep -Fxq "${package_name}"; then
      info "Skipping already requested package: ${package_name}"
    else
      packages_to_install+=("${package_name}")
    fi
  done

  if [[ ${#packages_to_install[@]} -eq 0 ]]; then
    log "All requested packages are already present"
    return 0
  fi

  # Install one at a time so a single "already requested" error doesn't block others
  for package in "${packages_to_install[@]}"; do
    if rpm -q "${package}" &>/dev/null; then
      info "Already installed: ${package}"
    else
      sudo rpm-ostree install --assumeyes --allow-inactive "${package}" ||
        warn "Failed to install: ${package} (may already be requested)"
    fi
  done

  log "Package installation complete"
}

remove_default_filemanager() {
  print_header "Removing Default File Manager (Thunar)"

  if ! is_fedora_atomic; then
    warn "Skipping (not on Fedora Atomic)"
    return 0
  fi

  if rpm -q Thunar &>/dev/null; then
    info "Thunar detected, removing..."
    sudo rpm-ostree override remove Thunar thunar-archive-plugin ||
      warn "Failed to remove Thunar"
    log "Thunar removal staged (requires reboot)"
  else
    log "Thunar not installed, skipping"
  fi
}

# ============================================================================
# Directory Setup
# ============================================================================

create_directories() {
  print_header "Creating Configuration Directories"

  local dirs=(
    "${XDG_CONFIG_HOME}/sway"
    "${XDG_CONFIG_HOME}/alacritty"
    "${XDG_CONFIG_HOME}/alacritty/themes"
    "${XDG_CONFIG_HOME}/k9s"
    "${XDG_CONFIG_HOME}/waybar"
    "${XDG_CONFIG_HOME}/rofi"
    "${XDG_DATA_HOME}/nvim"
  )

  for dir in "${dirs[@]}"; do
    mkdir -p "${dir}"
    log "Created: ${dir}"
  done

  if [[ ! -d "${XDG_CONFIG_HOME}/alacritty/themes/.git" ]]; then
    git clone https://github.com/alacritty/alacritty-theme "${XDG_CONFIG_HOME}/alacritty/themes"
    info "Cloned alacritty-theme into ${XDG_CONFIG_HOME}/alacritty/themes"
  fi
}

# ============================================================================
# Symlink Management
# ============================================================================

create_symlink() {
  local source="$1"
  local target="$2"

  [[ ! -e "${source}" ]] && {
    warn "Source missing: ${source}"
    return 1
  }

  if [[ -L "${target}" ]]; then
    rm "${target}"
    info "Removed old symlink: ${target}"
  elif [[ -d "${target}" && -z "$(find "${target}" -mindepth 1 -print-quit 2>/dev/null)" ]]; then
    rmdir "${target}"
    info "Removed empty directory: ${target}"
  elif [[ -e "${target}" ]]; then
    local backup="${target}.bak.$(date +%Y%m%d%H%M%S)"
    mv "${target}" "${backup}"
    warn "Existing target backed up: ${target} -> ${backup}"
  fi

  ln -s "${source}" "${target}"
  log "Symlinked: $(basename ${target})"
}

setup_symlinks() {
  print_header "Creating Configuration Symlinks"

  create_symlink "${DOTFILES_DIR}/sway/config" "${XDG_CONFIG_HOME}/sway/config" || true
  create_symlink "${DOTFILES_DIR}/alacritty.toml" "${XDG_CONFIG_HOME}/alacritty/alacritty.toml" || true
  create_symlink "${DOTFILES_DIR}/waybar/config.jsonc" "${XDG_CONFIG_HOME}/waybar/config" || true
  create_symlink "${DOTFILES_DIR}/waybar/style.css" "${XDG_CONFIG_HOME}/waybar/style.css" || true
  create_symlink "${DOTFILES_DIR}/k9s/skin.yml" "${XDG_CONFIG_HOME}/k9s/skin.yml" || true
  create_symlink "${DOTFILES_DIR}/rofi/config.rasi" "${XDG_CONFIG_HOME}/rofi/config.rasi" || true
  create_symlink "${DOTFILES_DIR}/nvim" "${XDG_CONFIG_HOME}/nvim" || true
  create_symlink "${DOTFILES_DIR}/starship.toml" "${XDG_CONFIG_HOME}/starship.toml" || true

  create_symlink "${DOTFILES_DIR}/.tmux.conf" "${HOME}/.tmux.conf" || true
  create_symlink "${DOTFILES_DIR}/.zshrc" "${HOME}/.zshrc" || true
  create_symlink "${DOTFILES_DIR}/.bashrc" "${HOME}/.bashrc" || true
  create_symlink "${DOTFILES_DIR}/.inputrc" "${HOME}/.inputrc" || true
}

# ============================================================================
# Sway Configuration
# ============================================================================

setup_sway_config() {
  print_header "Configuring Sway"

  local sway_config="${XDG_CONFIG_HOME}/sway/config"

  if [[ -f "${sway_config}" ]]; then
    sed -i --follow-symlinks 's|bindsym \$mod+e exec flatpak run org\.gnome\.Nautilus|bindsym $mod+e exec nautilus|' "${sway_config}"
    sed -i --follow-symlinks '/swaylock -f -c 282828/d' "${sway_config}"
  fi

  if ! grep -q "waybar" "${sway_config}"; then
    echo "exec_always --no-startup-id waybar" >>"${sway_config}"
    log "Added waybar autostart"
  fi

  log "Sway configuration ready"
}

# ============================================================================
# Environment Setup
# ============================================================================

setup_environment() {
  print_header "Setting Up Environment"

  local env_file="${HOME}/.sway-env"

  cat >"${env_file}" <<'EOF'
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export QT_QPA_PLATFORM=wayland
export QT_STYLE_OVERRIDE=adwaita-dark
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export LIBSEAT_BACKEND=logind
export CLUTTER_BACKEND=wayland
export GDK_BACKEND=wayland
EOF

  for shell_rc in "${HOME}/.bashrc" "${HOME}/.zshrc"; do
    [[ ! -f "${shell_rc}" ]] && continue
    if ! grep -q ".sway-env" "${shell_rc}" 2>/dev/null; then
      echo "source ~/.sway-env 2>/dev/null || true" >>"${shell_rc}"
      log "Added environment source to $(basename ${shell_rc})"
    fi
  done
}

setup_services() {
  print_header "Setting Up Services"

  if ! is_fedora_atomic; then
    warn "On a non-atomic system, you can enable sddm with 'sudo systemctl enable --force sddm.service'"
    return 0
  fi

  # On Fedora Atomic, service changes should usually happen on the host.
  # But we can try to enable it if the service already exists from a previous ostree commit.
  if systemctl list-unit-files | grep -q "^sddm.service"; then
    sudo systemctl enable --force sddm.service || warn "Could not enable SDDM."
    log "Enabled SDDM display manager"
  else
    warn "SDDM service not active yet. It will be available after you reboot into the new ostree deployment."
    info "After rebooting, run: sudo systemctl enable --force sddm.service"
  fi
}

# ============================================================================
# SDDM Theme Setup
# ============================================================================

setup_sddm_theme() {
  print_header "Setting Up SilentSDDM Theme"

  local themes_dir="/usr/local/share/sddm/themes"
  local theme_name="silent"
  local tmp_dir="/tmp/SilentSDDM"

  if [ -d "${themes_dir}/${theme_name}" ]; then
    warn "SilentSDDM theme already exists in ${themes_dir}/${theme_name}"
    return 0
  fi

  log "Cloning SilentSDDM repository..."
  rm -rf "${tmp_dir}"
  git clone -b main --depth=1 https://github.com/uiriansan/SilentSDDM "${tmp_dir}"

  log "Copying theme files..."
  sudo mkdir -p "${themes_dir}/${theme_name}"
  sudo cp -rf "${tmp_dir}"/. "${themes_dir}/${theme_name}/"

  log "Copying fonts..."
  sudo mkdir -p /usr/local/share/fonts
  sudo cp -r "${tmp_dir}/fonts/"* /usr/local/share/fonts/

  log "Configuring SDDM..."
  sudo mkdir -p /etc/sddm.conf.d
  local sddm_conf="/etc/sddm.conf.d/silent.conf"

  cat <<EOF | sudo tee "${sddm_conf}" >/dev/null
[Theme]
Current=silent
ThemeDir=${themes_dir}

[General]
InputMethod=qtvirtualkeyboard
GreeterEnvironment=QML2_IMPORT_PATH=${themes_dir}/silent/components/,QT_IM_MODULE=qtvirtualkeyboard
EOF

  rm -rf "${tmp_dir}"
  log "SilentSDDM theme setup complete"
}

# ============================================================================
# Theme Setup
# ============================================================================

setup_theme() {
  print_header "Setting Up Gruvbox Theme"

  local gtk_settings="${XDG_CONFIG_HOME}/gtk-3.0/settings.ini"
  mkdir -p "$(dirname ${gtk_settings})"

  cat >"${gtk_settings}" <<'EOF'
[Settings]
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Adwaita
gtk-application-prefer-dark-theme=true
gtk-font-name=UbuntuMono Nerd Font 10
EOF

  log "Configured GTK theme"
}

# ============================================================================
# Font Setup
# ============================================================================

setup_fonts() {
  print_header "Setting Up Fonts"

  local fonts_dir="${XDG_DATA_HOME}/fonts"
  mkdir -p "${fonts_dir}"

  if [[ -d "${DOTFILES_DIR}/fonts" ]]; then
    cp -r "${DOTFILES_DIR}/fonts"/* "${fonts_dir}/" 2>/dev/null || true
    log "Copied fonts from dotfiles"
  fi

  fc-cache -fv >/dev/null 2>&1 || warn "Font cache may need manual refresh"
  log "Font cache rebuilt"
}

# ============================================================================
# Verification
# ============================================================================

verify_setup() {
  print_header "Verifying Installation"

  local apps=("sway" "waybar" "alacritty" "k9s" "rofi" "nvim")
  local configs=(
    "${XDG_CONFIG_HOME}/sway/config"
    "${XDG_CONFIG_HOME}/alacritty/alacritty.toml"
    "${XDG_CONFIG_HOME}/k9s/skin.yml"
    "${XDG_CONFIG_HOME}/waybar/config"
    "${XDG_CONFIG_HOME}/rofi/config.rasi"
  )

  for app in "${apps[@]}"; do
    if command -v "${app}" &>/dev/null; then
      log "${app} installed"
    else
      warn "${app} not found"
    fi
  done

  for config in "${configs[@]}"; do
    if [[ -e "${config}" ]]; then
      log "Config: $(basename ${config})"
    else
      warn "Missing: ${config}"
    fi
  done
}

# ============================================================================
# Summary
# ============================================================================

print_summary() {
  cat <<EOF

${GREEN}═══════════════════════════════════════${NC}
${GREEN}  Sway Setup Complete!${NC}
${GREEN}═══════════════════════════════════════${NC}

${BLUE}Keybindings (Hyprland Style):${NC}
  • Super+Q       Terminal
  • Super+R       App menu
  • Super+C       Kill window
  • Super+M       Exit Sway
  • Super+[1-9]   Switch workspace
  • Super+Shift+[1-9] Move to workspace
  • Super+Arrows  Focus window
  • Super+F       Fullscreen

${BLUE}Next Steps:${NC}
  1. Log out → select Sway
  2. Log back in
  3. Use Super+Q for terminal
  4. Use Super+R for app menu

${BLUE}Log: ${LOG_FILE}${NC}

${GREEN}═══════════════════════════════════════${NC}

EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
  print_header "Sway Setup - Fedora Atomic"

  check_system || true
  remove_default_filemanager || true
  install_packages || true
  create_directories || true
  setup_symlinks || true
  setup_sway_config || true
  setup_environment || true
  setup_theme || true
  setup_sddm_theme || true
  setup_services || true
  setup_fonts || true
  verify_setup || true
  print_summary

  log "Setup complete!"
}

main "$@"
